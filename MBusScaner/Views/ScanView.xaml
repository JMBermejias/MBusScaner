<UserControl x:Class="MBusScaner.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:MBusScaner.Models"
             xmlns:viewModels="clr-namespace:MBusScaner.ViewModels"
             xmlns:converters="clr-namespace:MBusScaner.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:ScanViewModel}">
    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Cabecera ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Escaneo de Red de Climatización"
                       Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Explore el bus RJ45 para localizar controladores, unidades y componentes de la instalación"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===== Barra de escaneo ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Subred a escanear:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NetworkAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}"
                             Width="220" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                    <Button Content="Detectar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DetectNetworkCommand}"/>
                    <Button Content="{Binding ScanButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ScanCommand}"
                            Margin="16,4,0,4"
                            HorizontalAlignment="Right"/>
                </DockPanel>

                <ProgressBar Style="{StaticResource ProgressBarStyle}"
                             Value="{Binding Progress}"
                             Margin="0,12,0,0"/>
                <TextBlock Text="{Binding ScanSummary}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== Lista de dispositivos ===== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Dispositivos encontrados" Style="{StaticResource LabelStyle}" FontSize="14"/>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.Devices.Count, StringFormat=' {0} en total'}"
                               Style="{StaticResource ValueStyle}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.Devices}"
                          Style="{StaticResource DataGridStyle}"
                          SelectedItem="{Binding SelectedDevice, UpdateSourceTrigger=PropertyChanged}"
                          IsReadOnly="True"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Estado" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="12" Height="12"
                                                 Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="Dirección IP" Binding="{Binding IPAddress}" Width="130"/>
                        <DataGridTextColumn Header="Protocolo" Binding="{Binding ProtocolString}" Width="120"/>
                        <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="1*"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="1*"/>
                        <DataGridTextColumn Header="Última conexión" Binding="{Binding LastSeen, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Haga clic en un dispositivo para ver sus puertos, sensores y parámetros de control."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,8,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
