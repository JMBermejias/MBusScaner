<UserControl x:Class="MBusScaner.Views.AddDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:MBusScaner.ViewModels"
             xmlns:converters="clr-namespace:MBusScaner.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:AddDeviceViewModel}">
    <UserControl.Resources>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="16">

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Añadir dispositivo manualmente" Style="{StaticResource TitleStyle}"/>
                <TextBlock Text="Introduzca la dirección del equipo para probar su ficha sin escanear la red"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Datos del dispositivo" Style="{StaticResource LabelStyle}" FontSize="15"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Nombre del dispositivo" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Dirección IP" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DeviceIP, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Protocolo" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Style="{StaticResource ComboBoxStyle}"
                                      SelectedIndex="{Binding ProtocolIndex}"
                                      Margin="0,4,0,0">
                                <ComboBoxItem Content="Modbus TCP/IP"/>
                                <ComboBoxItem Content="BACnet/IP"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Puerto TCP" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unidad (Unit ID)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsModbus}"
                                     Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                            <TextBlock Text="Solo aplica a Modbus TCP"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#D32F2F" FontWeight="SemiBold"
                               Margin="0,14,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ValidationMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}"/>
                        <Button Content="Añadir dispositivo" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
                    </StackPanel>

                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="12" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Consejo"
                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="El dispositivo se añadirá como 'Fuera de línea' y podrá ver sus puertos, sensores y parámetros de control de ejemplo, para explorar la aplicación sin necesidad de hardware real."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>