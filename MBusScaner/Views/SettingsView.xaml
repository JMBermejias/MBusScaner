<UserControl x:Class="MBusScaner.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:MBusScaner.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">
    <ScrollViewer>
        <StackPanel Margin="16">

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Configuración" Style="{StaticResource TitleStyle}"/>
                <TextBlock Text="Parámetros de red y del escáner"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Información de la red local -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Información de red local" Style="{StaticResource LabelStyle}" FontSize="15"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Dirección IP del PC" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding LocalIP}" Style="{StaticResource ValueStyle}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Dirección MAC" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding MACAddress}" Style="{StaticResource ValueStyle}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Puertos de protocolo -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Puertos de protocolo" Style="{StaticResource LabelStyle}" FontSize="15"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Puerto Modbus TCP" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ModbusPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Puerto BACnet/IP" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding BacnetPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Intervalo de lectura (ms)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,8,0">
                <Button Content="Restablecer" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetCommand}"/>
                <Button Content="Guardar configuración" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="8,20,8,8">
                <StackPanel>
                    <TextBlock Text="Acerca de HVAC Bus Scanner" Style="{StaticResource LabelStyle}" FontSize="15"/>
                    <TextBlock Text="Versión 1.0.0" Style="{StaticResource ValueStyle}" Margin="0,8,0,0"/>
                    <TextBlock Text="Software de escaneo y control de redes de climatización (HVAC) mediante conexión RJ45."
                               Style="{StaticResource ValueStyle}" Margin="0,4,0,0"/>
                    <TextBlock Text="Protocolos soportados: Modbus TCP/IP y BACnet/IP"
                               Style="{StaticResource ValueStyle}" Margin="0,4,0,0"/>
                    <TextBlock Text="Desarrollado por Jose Manuel Bernabeu Mejias"
                               Style="{StaticResource ValueStyle}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBlock Text="Licencia: GNU General Public License v3.0"
                               Style="{StaticResource ValueStyle}" Margin="0,4,0,0"/>
                    <TextBlock Text="© 2026 - Distribuido bajo licencia GPL"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
