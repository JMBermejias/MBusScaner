<UserControl x:Class="MBusScaner.Views.DeviceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:MBusScaner.Models"
             xmlns:viewModels="clr-namespace:MBusScaner.ViewModels"
             xmlns:converters="clr-namespace:MBusScaner.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:DeviceDetailViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:EnumToVisConverter x:Key="EnumToVisConverter"/>
        <converters:EnumToTextBoxVisConverter x:Key="EnumToTextBoxVisConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Cabecera con información del dispositivo ===== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="← Volver"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BackCommand}"/>
                <Button DockPanel.Dock="Right" Content="Actualizar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}"/>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DeviceName}" Style="{StaticResource TitleStyle}"/>
                        <Border Background="#E3F2FD" CornerRadius="4" Padding="8,2" Margin="12,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeviceStatusText}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Dirección IP" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding DeviceAddress}" Style="{StaticResource ValueStyle}" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Protocolo" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding DeviceProtocolDisplay}" Style="{StaticResource ValueStyle}" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="Fabricante" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding DeviceManufacturer}" Style="{StaticResource ValueStyle}"/>
                            <TextBlock Text="{Binding DeviceModel}" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Versión firmware" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding DeviceFirmware}" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding DeviceStatus}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Panel principal con pestañas ===== -->
        <TabControl Grid.Row="1" Margin="8,8,8,0"
                    Background="Transparent" BorderThickness="0">
            <TabItem Header="Parámetros de Control" Padding="12">
                <DockPanel>
                    <!-- Lista de parámetros -->
                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Parameters}"
                              Style="{StaticResource DataGridStyle}"
                              SelectedItem="{Binding SelectedParameter}"
                              AutoGenerateColumns="False"
                              MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parámetro" Binding="{Binding Name}" Width="1.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="2.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Valor actual" Binding="{Binding DisplayValue}" Width="1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="0.6*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Editable" Binding="{Binding IsWritable}" Width="0.7*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Editor del parámetro seleccionado -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Editor de parámetro" Style="{StaticResource LabelStyle}" FontSize="15"/>
                            <TextBlock Text="{Binding SelectedParameter.Name, TargetNullValue='Seleccione un parámetro de la lista superior para editarlo'}"
                                       Style="{StaticResource ValueStyle}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,8"/>

                            <Grid IsEnabled="{Binding SelectedParameter.IsWritable, TargetNullValue=False}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <TextBlock Text="Nuevo valor:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <!-- ComboBox para enumeraciones -->
                                    <ComboBox ItemsSource="{Binding SelectedParameter.Options}"
                                              SelectedIndex="{Binding SelectedParameter.Value, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding SelectedParameter.Type, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource EnumToVisConverter}}"
                                              Width="180" Style="{StaticResource ComboBoxStyle}"/>

                                    <!-- TextBox numérico -->
                                    <TextBox Text="{Binding SelectedParameter.Value, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120" Style="{StaticResource TextBoxStyle}"
                                             Visibility="{Binding SelectedParameter.Type, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource EnumToTextBoxVisConverter}}"/>
                                    <TextBlock Text="{Binding SelectedParameter.Unit}" Style="{StaticResource ValueStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedParameter.Step, StringFormat='Paso: {0}'}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Row="1" Grid.Column="1" Content="Guardar cambios"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveParameterCommand}"
                                        CommandParameter="{Binding SelectedParameter}"
                                        Margin="0,12,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Sensores" Padding="12">
                <Grid>
                    <DataGrid ItemsSource="{Binding Sensors}"
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="1.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeString}" Width="1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding Value, StringFormat=F1}" Width="0.8*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="0.6*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Rango" Binding="{Binding MinValue, StringFormat='{}{0:F0} - '}" Width="1*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Puertos" Padding="12">
                <Grid>
                    <DataGrid ItemsSource="{Binding Ports}"
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dirección" Binding="{Binding Address}" Width="0.7*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="1.3*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeString}" Width="1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Función" Binding="{Binding Function}" Width="1.3*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding CurrentValue}" Width="0.6*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="0.6*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
